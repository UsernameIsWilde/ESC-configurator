diff --git a/src/sources/AM32/__tests__/extendedLayout.test.js b/src/sources/AM32/__tests__/extendedLayout.test.js
new file mode 100644
index 0000000..5c6cf31
--- /dev/null
+++ b/src/sources/AM32/__tests__/extendedLayout.test.js
@@ -0,0 +1,343 @@
+import Convert from '../../../utils/helpers/Convert';
+import { source } from '../';
+
+const EEPROM = source.getEeprom();
+const SETTINGS_DESCRIPTIONS = source.getSettingsDescriptions();
+
+/**
+ * Default EEPROM image for EEPROM version 4 as shipped with the AM32
+ * configurator (public/eeprom-defaults/DEFAULT/v4.bin). No melody, no CAN
+ * settings.
+ */
+const EEPROM_V4 = new Uint8Array(0xC0).fill(0xFF);
+EEPROM_V4.set([
+  0x01, 0x04, 0x01, 0x02, 0x15, 0xA0, 0x04, 0x00, 0x0A, 0x64, 0x00, 0x32, 0x02, 0x00, 0x35, 0x31,
+  0x20, 0x00, 0x00, 0x00, 0x01, 0x01, 0x01, 0x1A, 0x18, 0x64, 0x37, 0x0E, 0x00, 0x00, 0x05, 0x00,
+  0x80, 0x80, 0x80, 0x32, 0x00, 0x32, 0x00, 0x00, 0x0F, 0x0A, 0x0A, 0x8D, 0x66, 0x06, 0x01, 0x00,
+]);
+
+const getSetting = (revision, name) => (
+  source.getCommonSettings(revision).base.find((setting) => setting.name === name)
+);
+
+describe('AM32 extended EEPROM layout', () => {
+  it('should be used for EEPROM version 3 and up', () => {
+    [0, 1, 2, '2'].forEach((revision) => {
+      expect(source.hasExtendedLayout(revision)).toBeFalsy();
+      expect(source.getLayout(revision)).toBe(EEPROM.LAYOUT);
+      expect(source.getLayoutSize(revision)).toEqual(0xB0);
+    });
+
+    [3, 4, '4', 5].forEach((revision) => {
+      expect(source.hasExtendedLayout(revision)).toBeTruthy();
+      expect(source.getLayout(revision)).toBe(EEPROM.LAYOUT_EXTENDED);
+      expect(source.getLayoutSize(revision)).toEqual(0xC0);
+    });
+
+    // Without a revision and on an erased EEPROM nothing changes
+    expect(source.getLayout()).toBe(EEPROM.LAYOUT);
+    expect(source.getLayoutSize()).toEqual(0xB0);
+    expect(source.hasExtendedLayout(0xFF)).toBeFalsy();
+  });
+
+  it('should not overlap and stay within the EEPROM', () => {
+    const used = new Array(EEPROM.LAYOUT_SIZE_EXTENDED).fill(null);
+    for(const [name, {
+      offset, size,
+    }] of Object.entries(EEPROM.LAYOUT_EXTENDED)) {
+      for(let i = offset; i < offset + size; i += 1) {
+        expect(i).toBeLessThan(EEPROM.LAYOUT_SIZE_EXTENDED);
+        expect(`${i}: ${used[i]}`).toEqual(`${i}: null`);
+        used[i] = name;
+      }
+    }
+
+    // Reserved bytes and the CAN block are not part of the layout
+    const unknown = used.map((name, i) => (name ? null : i)).filter((i) => i !== null);
+    expect(unknown).toEqual([0x0F, 0x10, ...Array.from({ length: 16 }, (_, i) => 0xB0 + i)]);
+    expect(EEPROM.LAYOUT_EXTENDED.NAME).toBeUndefined();
+  });
+
+  it('should read settings from the positions the firmware uses', () => {
+    const settings = Convert.arrayToSettingsObject(EEPROM_V4, EEPROM.LAYOUT_EXTENDED);
+
+    expect(settings).toMatchObject({
+      BOOT_BYTE: 1,
+      LAYOUT_REVISION: 4,
+      BOOT_LOADER_REVISION: 1,
+      MAIN_REVISION: 2,
+      SUB_REVISION: 21,
+      MAX_RAMP: 160,
+      MINIMUM_DUTY_CYCLE: 4,
+      DISABLE_STICK_CALIBRATION: 0,
+      ABSOLUTE_VOLTAGE_CUTOFF: 10,
+      CURRENT_P: 100,
+      CURRENT_I: 0,
+      CURRENT_D: 50,
+      ACTIVE_BRAKE_POWER: 2,
+      BRAKE_ON_ZERO_THROTTLE: 0,
+      MOTOR_DIRECTION: 0,
+      BIDIRECTIONAL_MODE: 0,
+      SINUSOIDAL_STARTUP: 0,
+      COMPLEMENTARY_PWM: 1,
+      VARIABLE_PWM_FREQUENCY: 1,
+      STUCK_ROTOR_PROTECTION: 1,
+      TIMING_ADVANCE: 26,
+      PWM_FREQUENCY: 24,
+      STARTUP_POWER: 100,
+      MOTOR_KV: 55,
+      MOTOR_POLES: 14,
+      BRAKE_ON_STOP: 0,
+      STALL_PROTECTION: 0,
+      BEEP_VOLUME: 5,
+      INTERVAL_TELEMETRY: 0,
+      SERVO_LOW_THRESHOLD: 128,
+      SERVO_HIGH_THRESHOLD: 128,
+      SERVO_NEUTRAL: 128,
+      SERVO_DEAD_BAND: 50,
+      LOW_VOLTAGE_CUTOFF: 0,
+      LOW_VOLTAGE_THRESHOLD: 50,
+      RC_CAR_REVERSING: 0,
+      USE_HALL_SENSORS: 0,
+      SINE_MODE_RANGE: 15,
+      BRAKE_STRENGTH: 10,
+      RUNNING_BRAKE_LEVEL: 10,
+      TEMPERATURE_LIMIT: 141,
+      CURRENT_LIMIT: 102,
+      SINE_MODE_POWER: 6,
+      ESC_PROTOCOL: 1,
+      AUTO_ADVANCE: 0,
+    });
+
+    expect(settings.STARTUP_MELODY).toEqual(Array.from(EEPROM_V4.subarray(0x30, 0xB0)));
+  });
+
+  it('should write back exactly what has been read', () => {
+    const settings = Convert.arrayToSettingsObject(EEPROM_V4, EEPROM.LAYOUT_EXTENDED);
+    const written = Convert.objectToSettingsArray(
+      settings,
+      EEPROM.LAYOUT_EXTENDED,
+      EEPROM.LAYOUT_SIZE_EXTENDED,
+      Array.from(EEPROM_V4)
+    );
+
+    expect(Array.from(written)).toEqual(Array.from(EEPROM_V4));
+  });
+
+  it('should keep bytes it does not know about', () => {
+    const image = Uint8Array.from(EEPROM_V4);
+
+    // Reserved bytes, a melody and the CAN settings of a CAN ESC
+    image.set([0x12, 0x34], 0x0F);
+    image.set([2, 58, 4, 32, 52, 66, 13, 0, 200, 255, 0, 9], 0x30);
+    image.set([7, 2, 1, 50, 0, 80, 0, 1, 9, 8, 7, 6, 5, 4, 3, 2], 0xB0);
+
+    const settings = Convert.arrayToSettingsObject(image, EEPROM.LAYOUT_EXTENDED);
+
+    // A slider and a selection - the latter hands back a string
+    settings.MAX_RAMP = 42;
+    settings.BRAKE_ON_ZERO_THROTTLE = '2';
+
+    const written = Convert.objectToSettingsArray(
+      settings,
+      EEPROM.LAYOUT_EXTENDED,
+      EEPROM.LAYOUT_SIZE_EXTENDED,
+      Array.from(image)
+    );
+
+    const changed = [];
+    written.forEach((value, i) => {
+      if(value !== image[i]) {
+        changed.push([i, value]);
+      }
+    });
+
+    expect(changed).toEqual([[0x05, 42], [0x0D, 2]]);
+  });
+
+  it('should keep the value on the ESC if a setting is missing', () => {
+    const settings = Convert.arrayToSettingsObject(EEPROM_V4, EEPROM.LAYOUT_EXTENDED);
+    delete settings.CURRENT_P;
+    delete settings.STARTUP_MELODY;
+    settings.MOTOR_POLES = 12;
+
+    const written = Convert.objectToSettingsArray(
+      settings,
+      EEPROM.LAYOUT_EXTENDED,
+      EEPROM.LAYOUT_SIZE_EXTENDED,
+      Array.from(EEPROM_V4)
+    );
+
+    const expected = Uint8Array.from(EEPROM_V4);
+    expected[0x1B] = 12;
+    expect(Array.from(written)).toEqual(Array.from(expected));
+  });
+
+  it('should erase unknown bytes when there is nothing to keep', () => {
+    const settings = Convert.arrayToSettingsObject(EEPROM_V4, EEPROM.LAYOUT_EXTENDED);
+    const written = Convert.objectToSettingsArray(settings, EEPROM.LAYOUT_EXTENDED, EEPROM.LAYOUT_SIZE_EXTENDED);
+
+    expect(Array.from(written.subarray(0x0F, 0x11))).toEqual([0xFF, 0xFF]);
+    expect(Array.from(written.subarray(0, 0x0F))).toEqual(Array.from(EEPROM_V4.subarray(0, 0x0F)));
+  });
+
+  it('should only describe settings that are part of the layout', () => {
+    ['3', '4'].forEach((revision) => {
+      const common = source.getCommonSettings(revision).base;
+      const individual = source.getIndividualSettings(revision).base;
+      const defaults = source.getDefaultSettings(revision);
+
+      const names = [...common, ...individual].map((setting) => setting.name);
+      names.forEach((name) => {
+        expect(`${name}: ${typeof EEPROM.LAYOUT_EXTENDED[name]}`).toEqual(`${name}: object`);
+      });
+
+      // Every setting shows up once and has a default that fits into a byte
+      const commonNames = common.map((setting) => setting.name);
+      expect(new Set(commonNames).size).toEqual(commonNames.length);
+      commonNames.forEach((name) => {
+        const value = defaults[name];
+        const valid = Number.isInteger(value) && value >= 0 && value <= 255;
+        expect(`${name}: ${valid}`).toEqual(`${name}: true`);
+      });
+    });
+
+    const names3 = source.getCommonSettings('3').base.map((setting) => setting.name);
+    const names4 = source.getCommonSettings('4').base.map((setting) => setting.name);
+    expect(names3).not.toContain('BRAKE_ON_ZERO_THROTTLE');
+    expect(names3).not.toContain('DEMAG_COMPENSATION');
+    expect(names4).toContain('BRAKE_ON_ZERO_THROTTLE');
+    expect(names4).toContain('DEMAG_COMPENSATION');
+  });
+
+  it('should match the defaults of the AM32 configurator', () => {
+    const image = Convert.arrayToSettingsObject(EEPROM_V4, EEPROM.LAYOUT_EXTENDED);
+    const defaults = source.getDefaultSettings('4');
+
+    // The melody is the one of this configurator, byte 14 a left over
+    const compared = Object.entries(defaults)
+      .filter(([name]) => !['STARTUP_MELODY', 'DEMAG_COMPENSATION'].includes(name));
+
+    expect(compared.length).toEqual(40);
+    compared.forEach(([name, value]) => {
+      expect(`${name}: ${value}`).toEqual(`${name}: ${image[name]}`);
+    });
+  });
+
+  it('should convert every value to its display value and back', () => {
+    const numbers = source.getCommonSettings('4').base.filter((setting) => setting.type === 'number');
+
+    numbers.forEach((setting) => {
+      const factor = setting.displayFactor || 1;
+      const offset = setting.displayOffset || 0;
+      const decimals = setting.decimals || 0;
+      const precision = Math.pow(10, decimals);
+
+      // Same conversion as in the slider
+      const toStored = (value) => {
+        const stored = (value - offset) / factor;
+
+        return decimals > 0 ? Math.round(stored) : Math.floor(stored);
+      };
+
+      const first = Math.round((setting.min - offset) / factor);
+      const last = Math.round((setting.max - offset) / factor);
+      expect(first).toBeGreaterThanOrEqual(0);
+      expect(last).toBeLessThanOrEqual(255);
+
+      const shown = new Set();
+      for(let stored = first; stored <= last; stored += 1) {
+        // The exact value while dragging ...
+        const exact = stored * factor + offset;
+        expect(`${setting.name} ${stored}: ${toStored(exact)}`).toEqual(`${setting.name} ${stored}: ${stored}`);
+
+        // ... and the one that is shown, rounded to the decimals of the setting
+        const display = Math.round(exact * precision) / precision;
+        expect(`${setting.name} ${stored}: ${toStored(display)}`).toEqual(`${setting.name} ${stored}: ${stored}`);
+        shown.add(display);
+      }
+
+      // No two values may look the same
+      expect(`${setting.name}: ${shown.size}`).toEqual(`${setting.name}: ${last - first + 1}`);
+    });
+  });
+
+  it('should show what the firmware makes of the timing advance', () => {
+    const timing = getSetting('4', 'TIMING_ADVANCE');
+
+    // Old format: 0 - 3 in 7.5 degree steps
+    expect(timing.sanitize({ TIMING_ADVANCE: 0 })).toEqual({ TIMING_ADVANCE: 10 });
+    expect(timing.sanitize({ TIMING_ADVANCE: 2 })).toEqual({ TIMING_ADVANCE: 26 });
+    expect(timing.sanitize({ TIMING_ADVANCE: 3 })).toEqual({ TIMING_ADVANCE: 34 });
+
+    // New format is taken as it is
+    expect(timing.sanitize({ TIMING_ADVANCE: 10 })).toEqual({ TIMING_ADVANCE: 10 });
+    expect(timing.sanitize({ TIMING_ADVANCE: 42 })).toEqual({ TIMING_ADVANCE: 42 });
+
+    // Anything else results in 15 degrees
+    expect(timing.sanitize({ TIMING_ADVANCE: 7 })).toEqual({ TIMING_ADVANCE: 26 });
+    expect(timing.sanitize({ TIMING_ADVANCE: 255 })).toEqual({ TIMING_ADVANCE: 26 });
+    expect(26 * timing.displayFactor + timing.displayOffset).toEqual(15);
+    expect(10 * timing.displayFactor + timing.displayOffset).toEqual(timing.min);
+    expect(42 * timing.displayFactor + timing.displayOffset).toEqual(timing.max);
+
+    // Not used while the ESC picks the timing itself
+    expect(timing.visibleIf({ AUTO_ADVANCE: 0 })).toBeTruthy();
+    expect(timing.visibleIf({ AUTO_ADVANCE: 1 })).toBeFalsy();
+  });
+
+  it('should only show settings that are in effect', () => {
+    // Selections hand back strings
+    expect(getSetting('4', 'PWM_FREQUENCY').visibleIf({ VARIABLE_PWM_FREQUENCY: '1' })).toBeTruthy();
+    expect(getSetting('4', 'PWM_FREQUENCY').visibleIf({ VARIABLE_PWM_FREQUENCY: '2' })).toBeFalsy();
+    expect(getSetting('4', 'BRAKE_STRENGTH').visibleIf({ BRAKE_ON_STOP: 1 })).toBeTruthy();
+    expect(getSetting('4', 'BRAKE_STRENGTH').visibleIf({ BRAKE_ON_STOP: '2' })).toBeFalsy();
+    expect(getSetting('4', 'ACTIVE_BRAKE_POWER').visibleIf({ BRAKE_ON_STOP: '2' })).toBeTruthy();
+    expect(getSetting('4', 'ACTIVE_BRAKE_POWER').visibleIf({ BRAKE_ON_STOP: 1 })).toBeFalsy();
+    expect(getSetting('4', 'LOW_VOLTAGE_THRESHOLD').visibleIf({ LOW_VOLTAGE_CUTOFF: 1 })).toBeTruthy();
+    expect(getSetting('4', 'LOW_VOLTAGE_THRESHOLD').visibleIf({ LOW_VOLTAGE_CUTOFF: '2' })).toBeFalsy();
+    expect(getSetting('4', 'ABSOLUTE_VOLTAGE_CUTOFF').visibleIf({ LOW_VOLTAGE_CUTOFF: 1 })).toBeFalsy();
+    expect(getSetting('4', 'ABSOLUTE_VOLTAGE_CUTOFF').visibleIf({ LOW_VOLTAGE_CUTOFF: '2' })).toBeTruthy();
+
+    // Demag compensation came with firmware 2.22
+    const demag = getSetting('4', 'DEMAG_COMPENSATION');
+    expect(demag.visibleIf({
+      MAIN_REVISION: 2,
+      SUB_REVISION: 21,
+    })).toBeFalsy();
+    expect(demag.visibleIf({
+      MAIN_REVISION: 2,
+      SUB_REVISION: 22,
+    })).toBeTruthy();
+    expect(demag.visibleIf({
+      MAIN_REVISION: 3,
+      SUB_REVISION: 0,
+    })).toBeTruthy();
+  });
+
+  it('should show what the firmware makes of invalid values', () => {
+    expect(getSetting('4', 'DEMAG_COMPENSATION').sanitize({ DEMAG_COMPENSATION: 53 }))
+      .toEqual({ DEMAG_COMPENSATION: 0 });
+    expect(getSetting('4', 'BRAKE_ON_ZERO_THROTTLE').sanitize({ BRAKE_ON_ZERO_THROTTLE: 0x30 }))
+      .toEqual({ BRAKE_ON_ZERO_THROTTLE: 0 });
+    expect(getSetting('4', 'BRAKE_ON_ZERO_THROTTLE').sanitize({ BRAKE_ON_ZERO_THROTTLE: 4 }))
+      .toEqual({ BRAKE_ON_ZERO_THROTTLE: 4 });
+    expect(getSetting('4', 'AUTO_ADVANCE').sanitize({ AUTO_ADVANCE: 255 })).toEqual({ AUTO_ADVANCE: 1 });
+    expect(getSetting('4', 'AUTO_ADVANCE').sanitize({ AUTO_ADVANCE: 0 })).toEqual({ AUTO_ADVANCE: 0 });
+    expect(getSetting('4', 'MINIMUM_DUTY_CYCLE').sanitize({ MINIMUM_DUTY_CYCLE: 79 }))
+      .toEqual({ MINIMUM_DUTY_CYCLE: 0 });
+    expect(getSetting('4', 'MINIMUM_DUTY_CYCLE').sanitize({ MINIMUM_DUTY_CYCLE: 50 }))
+      .toEqual({ MINIMUM_DUTY_CYCLE: 50 });
+  });
+
+  it('should leave the layouts of older firmware untouched', () => {
+    expect(EEPROM.LAYOUT.NAME).toEqual({
+      offset: 0x05,
+      size: 12,
